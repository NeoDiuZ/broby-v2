# All provider activity is opt-in. Do not put secrets in web/ or NEXT_PUBLIC_*.
BROBY_ENABLE_AI=0
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# demo (default local preview), or password (requires provisioning with api/auth.py)
BROBY_AUTH_MODE=demo
BROBY_ENVIRONMENT=local
BROBY_SEED_DEMO=1
# Hosted only: use password authentication, an isolated persistent volume,
# and the exact HTTPS frontend origin. Keep these in Railway, not in Git.
# BROBY_DATA_DIR=/data
# BROBY_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
# BROBY_ADMIN_USERNAME=your-username
# BROBY_ADMIN_PASSWORD=<generated strong password; provisions once, never resets>
# BROBY_ADMIN_CLINIC=clinic-east
# BROBY_ADMIN_MEMBER=clinic-east-admin
# Frontend BUILD variable; private backend networking, never a V1 URL:
# BROBY_API_ORIGIN=http://backend.railway.internal:8000

# Required for the v2 patient spine. start-spine.sh provisions a local value.
# BROBY_SPINE_URL=postgresql+psycopg://user:password@127.0.0.1:55432/broby_spine
# BROBY_TEST_SPINE_URL can point acceptance tests at a separate PostgreSQL database.

# Optional clinical staff escalation. Default disabled; no recipients or timings
# are inferred. Configure only reviewed HTTPS aliases in backend secrets, then
# explicitly review the clinic policy in Handover. See CLINICAL_ESCALATION.md.
BROBY_CLINICAL_ESCALATION_MODE=disabled
# BROBY_CLINICAL_ESCALATION_ROUTES={"primary-alias":{"url":"https://receiver.example/primary","token":"..."},"backup-alias":{"url":"https://receiver.example/backup","token":"..."}}
